{
  "version": 1,
  "name": "Secuenciador 8 pasos",
  "modules": [
    {
      "id": "seq1",
      "type": "sequencer",
      "x": 30,
      "y": 60,
      "params": {
        "bpm": 110,
        "steps": [60, 0, 64, 0, 67, 64, 60, 55]
      }
    },
    {
      "id": "vco1",
      "type": "vco",
      "x": 300,
      "y": 40,
      "params": { "waveform": "sawtooth", "frequency": 220, "detune": 0, "pw": 0.5 }
    },
    {
      "id": "vcf1",
      "type": "vcf",
      "x": 520,
      "y": 40,
      "params": { "type": "lowpass", "frequency": 1800, "Q": 3 }
    },
    {
      "id": "adsr1",
      "type": "adsr",
      "x": 300,
      "y": 300,
      "params": { "attack": 0.01, "decay": 0.12, "sustain": 0.3, "release": 0.15 }
    },
    {
      "id": "vca1",
      "type": "vca",
      "x": 740,
      "y": 100,
      "params": { "gain": 0.85 }
    },
    {
      "id": "out1",
      "type": "output",
      "x": 960,
      "y": 120,
      "params": { "volume": 0.7 }
    }
  ],
  "wires": [
    { "from": "seq1:cv", "to": "vco1:freq" },
    { "from": "seq1:gate", "to": "adsr1:gate" },
    { "from": "vco1:out", "to": "vcf1:in" },
    { "from": "vcf1:out", "to": "vca1:in" },
    { "from": "adsr1:out", "to": "vca1:cv" },
    { "from": "vca1:out", "to": "out1:in" }
  ]
}

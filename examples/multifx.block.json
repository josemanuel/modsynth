{
  "name": "MultiFX",
  "description": "Delay \u2192 Chorus \u2192 Reverb",
  "modules": [
    {
      "id": "del",
      "type": "delay",
      "x": 0,
      "y": 0,
      "params": {
        "time": 0.25,
        "feedback": 0.35,
        "mix": 0.35
      }
    },
    {
      "id": "cho",
      "type": "chorus",
      "x": 200,
      "y": 0,
      "params": {
        "rate": 1.5,
        "depth": 0.004,
        "mix": 0.4
      }
    },
    {
      "id": "rev",
      "type": "reverb",
      "x": 400,
      "y": 0,
      "params": {
        "decay": 2.5,
        "mix": 0.3
      }
    }
  ],
  "wires": [
    {
      "from": "del:out",
      "to": "cho:in"
    },
    {
      "from": "cho:out",
      "to": "rev:in"
    }
  ],
  "expose": [
    {
      "id": "in",
      "name": "In",
      "type": "audio",
      "direction": "in",
      "target": "del:in"
    },
    {
      "id": "out",
      "name": "Out",
      "type": "audio",
      "direction": "out",
      "target": "rev:out"
    }
  ],
  "macros": [
    {
      "id": "delayMix",
      "label": "Delay Mix",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "value": 0.35,
      "target": "del",
      "param": "mix"
    },
    {
      "id": "delayTime",
      "label": "Delay Time",
      "min": 0.01,
      "max": 1,
      "step": 0.01,
      "value": 0.25,
      "target": "del",
      "param": "time"
    },
    {
      "id": "revMix",
      "label": "Reverb Mix",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "value": 0.3,
      "target": "rev",
      "param": "mix"
    }
  ]
}